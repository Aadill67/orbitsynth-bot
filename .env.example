# ─────────────────────────────────────────────────────────────────────────────
#  OrbitSynth Bot — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# Get this from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# ── AI (Google Gemini) ─────────────────────────────────────────────────────
# Get an API key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use — flash is fastest/cheapest; pro is most capable
# Options: gemini-1.5-flash | gemini-1.5-pro | gemini-2.0-flash-exp
AI_MODEL=gemini-1.5-flash

# Max tokens in each AI response (1024 is a good default for chat)
AI_MAX_TOKENS=1024

# ── IMAGE GENERATION (HuggingFace) ────────────────────────────────────────────
# Get an API key at: https://huggingface.co/settings/tokens
# Used by the /imagine command with FLUX.1-schnell
HF_API_KEY=your_huggingface_api_key_here

# ── DATABASE (optional) ───────────────────────────────────────────────────────
# Bot runs in memory-only mode if MongoDB is unavailable — no crash.
# Install MongoDB locally: https://www.mongodb.com/try/download/community
MONGODB_URI=mongodb://127.0.0.1:27017/orbitsynth

# ── ADMIN ACCESS ──────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs that bypass rate limiting
# Find your ID by messaging @userinfobot on Telegram
ADMIN_IDS=123456789

# ── LOGGING ───────────────────────────────────────────────────────────────────
# Options: error | warn | info | debug
LOG_LEVEL=info
