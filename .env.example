# ─────────────────────────────────────────────────────────────────────────────
#  OrbitSynth Bot — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# Get this from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# ── AI (Anthropic Claude) ─────────────────────────────────────────────────────
# Get an API key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model to use — haiku is fastest/cheapest; opus is most capable
# Options: claude-haiku-4-5-20251001 | claude-sonnet-4-6 | claude-opus-4-6
AI_MODEL=claude-haiku-4-5-20251001

# Max tokens in each AI response (1024 is a good default for chat)
AI_MAX_TOKENS=1024

# ── DATABASE (optional) ───────────────────────────────────────────────────────
# Bot runs in memory-only mode if MongoDB is unavailable — no crash.
# Install MongoDB locally: https://www.mongodb.com/try/download/community
MONGODB_URI=mongodb://127.0.0.1:27017/orbitsynth

# ── ADMIN ACCESS ──────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs that bypass rate limiting
# Find your ID by messaging @userinfobot on Telegram
ADMIN_IDS=123456789

# ── LOGGING ───────────────────────────────────────────────────────────────────
# Options: error | warn | info | debug
LOG_LEVEL=info
