# ─────────────────────────────────────────────────────────────────────────────
#  OrbitSynth Bot — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# Get this from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# ── WEBHOOK (set for Render — avoids 409 polling conflicts) ──────────────────
# Set this to your Render app URL, e.g. https://your-app.onrender.com
# The bot will listen for webhooks instead of polling
WEBHOOK_URL=https://your-app-name.onrender.com

# ── AI (Google Gemini) ─────────────────────────────────────────────────────
# Get an API key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use — flash is fastest/cheapest and fully stable.
# NOTE (2026): Google has retired all gemini-1.x and gemini-2.x models.
# Only gemini-3.6-flash and gemini-3-flash-preview are available on new keys.
AI_MODEL=gemini-3.6-flash

# Backup models tried (in order) if AI_MODEL is down. Comma-separated.
# Keep only models you know exist — a bad name wastes a slow retry cycle.
AI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3-flash-preview

# Max tokens in each AI response (1024 is a good default for chat)
AI_MAX_TOKENS=1024

# ── IMAGE GENERATION ──────────────────────────────────────────────────────────
# Uses Pollinations.ai (free, no API key needed)
# The /imagine command generates images via https://image.pollinations.ai

# ── VOICE TRANSCRIPTION (OpenAI Whisper) ──────────────────────────────────────
# Get an API key at: https://platform.openai.com/api-keys
# Used by the voice message handler for transcription
OPENAI_API_KEY=your_openai_api_key_here

# ── DATABASE (optional) ───────────────────────────────────────────────────────
# Bot runs in memory-only mode if MongoDB is unavailable — no crash.
# Install MongoDB locally: https://www.mongodb.com/try/download/community
MONGODB_URI=mongodb://127.0.0.1:27017/orbitsynth

# ── ADMIN ACCESS ──────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs that bypass rate limiting
# Find your ID by messaging @userinfobot on Telegram
ADMIN_IDS=123456789

# ── LOGGING ───────────────────────────────────────────────────────────────────
# Options: error | warn | info | debug
LOG_LEVEL=info
